# KrishiNetra Backend Environment Configuration
PROJECT_NAME="KrishiNetra Precision Pest Management Platform"
API_V1_STR="/api/v1"
SECRET_KEY="replace-with-a-cryptographically-secure-random-key"

# Database Connection (PostgreSQL for Production, SQLite for local desktop development)
# DATABASE_URL="postgresql+asyncpg://postgres:password@localhost:5432/krishinetra_db"
DATABASE_URL="sqlite+aiosqlite:///./krishnetra_backend.db"

# Session & Security
SESSION_EXPIRE_HOURS=24
ROVER_LEASE_DEFAULT_TTL_SEC=30
MEDIA_STORAGE_PATH="./data/media_evidence"
